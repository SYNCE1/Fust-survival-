local function toggle(parent, text, tbl, key)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 26)
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Font = FONT
	b.TextSize = 15
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.Parent = parent
	stroke(b, EDGE, 1)
	local function refresh()
		b.Text = "  " .. text .. ":  " .. (tbl[key] and "ON" or "OFF")
		b.BackgroundColor3 = tbl[key] and RUST or PANEL
		b.TextColor3 = tbl[key] and Color3.new(1, 1, 1) or TEXT
	end
	refresh()
	b.Activated:Connect(function() tbl[key] = not tbl[key]; refresh() end)
end

local function cycle(parent, text, tbl, key, names)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 26)
	b.BackgroundColor3 = PANEL
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Font = FONT
	b.TextSize = 15
	b.TextColor3 = TEXT
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.Parent = parent
	stroke(b, RUST, 1)
	local function refresh() b.Text = "  " .. text .. ":  < " .. names[tbl[key]] .. " >" end
	refresh()
	b.Activated:Connect(function()
		tbl[key] = tbl[key] % #names + 1
		refresh()
	end)
end

local activeSlider
local function slider(parent, text, tbl, key, min, max, decimals)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, 0, 0, 38)
	f.BackgroundColor3 = PANEL
	f.BorderSizePixel = 0
	f.Parent = parent
	stroke(f, EDGE, 1)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -10, 0, 18)
	lbl.Position = UDim2.fromOffset(8, 1)
	lbl.BackgroundTransparency = 1
	lbl.Font = FONT
	lbl.TextSize = 14
	lbl.TextColor3 = TEXT
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = f
	local bar = Instance.new("Frame")
	bar.Position = UDim2.new(0, 8, 0, 25)
	bar.Size = UDim2.new(1, -16, 0, 6)
	bar.BackgroundColor3 = BG
	bar.BorderSizePixel = 0
	bar.Parent = f
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = RUST
	fill.BorderSizePixel = 0
	fill.Parent = bar
	local mult = 10 ^ (decimals or 0)
	local function set(v)
		v = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
		tbl[key] = v
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		lbl.Text = text .. ": " .. tostring(v)
	end
	set(tbl[key])
	local function fromInput(x)
		set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1))
	end
	f.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			activeSlider = fromInput
			fromInput(i.Position.X)
		end
	end)
end

table.insert(connections, UIS.InputChanged:Connect(function(i)
	if activeSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		activeSlider(i.Position.X)
	end
end))
table.insert(connections, UIS.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		activeSlider = nil
	end
end))

