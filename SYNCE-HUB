local function makeEntity()
	return {
		Box = newDraw("Square", { Thickness = 1.5, Filled = false, Visible = false }),
		Head = newDraw("Square", { Thickness = 2, Filled = false, Visible = false }),
		Name = newDraw("Text", { Size = 14, Center = true, Outline = true, Visible = false, Color = Config.Colors.Text }),
		HP = newDraw("Line", { Thickness = 2, Visible = false }),
		visT = 0, rayVis = {},
	}
end

local function hideEntity(e)
	e.Box.Visible = false; e.Head.Visible = false; e.Name.Visible = false; e.HP.Visible = false
end

local function removeEntity(plr)
	local e = entities[plr]
	if not e then return end
	pcall(function() e.Box:Remove(); e.Head:Remove(); e.Name:Remove(); e.HP:Remove() end)
	entities[plr] = nil
end

----------------------------------------------------------------- main loop
local function onRender()
	if unloaded then return end
	Camera = Workspace.CurrentCamera
	if not Camera or not HAS_DRAWING then return end

	local now = os.clock()
	local camPos = Camera.CFrame.Position
	local center, centerIsScreen = getAimCenter()

	fovCircle.Visible = Config.Aim.Enabled and Config.Aim.ShowFOV
	fovCircle.Position = center
	fovCircle.Radius = Config.Aim.FOV

	local bestPos, bestScreen, bestDist = nil, nil, math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			local e = entities[plr]
			if not e then e = makeEntity(); entities[plr] = e end

			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)

			if not (char and hum and root) or hum.Health <= 0 then
				hideEntity(e)
			else
				local dist = (root.Position - camPos).Magnitude
				local espOn = Config.ESP.Enabled and dist <= Config.ESP.MaxDistance
					and not (Config.ESP.TeamCheck and isTeammate(plr))
				local aimOn = Config.Aim.Enabled and dist <= Config.Aim.MaxDistance
					and not (Config.Aim.TeamCheck and isTeammate(plr))

				if not espOn and not aimOn then
					hideEntity(e)
				else
					local parts = {}
					for _, def in ipairs(PART_DEFS) do parts[def.key] = findPart(char, def.names) end

					-- wall check ~10 times per second (saves FPS)
					if now - e.visT >= 0.1 then
						e.visT = now
						rayParams.FilterDescendantsInstances = { LP.Character, char }
						for _, def in ipairs(PART_DEFS) do
							local part = parts[def.key]
							local v = false
							if part then
								local sp, on = Camera:WorldToViewportPoint(part.Position)
								v = on and sp.Z > 0 and isPointVisible(camPos, part.Position)
							end
							e.rayVis[def.key] = v
						end
					end
					local anyVisible = false
					for _, def in ipairs(PART_DEFS) do
						if e.rayVis[def.key] then anyVisible = true; break end
					end

					local x1, y1, x2, y2
					if espOn then x1, y1, x2, y2 = bodyBox(char) end
					if espOn and x1 then
						local yo = Config.ESP.YOffset
						y1 += yo; y2 += yo
						local col = anyVisible and Config.Colors.Visible or Config.Colors.Hidden

						e.Box.Visible = Config.ESP.Box
						e.Box.Position = Vector2.new(x1, y1)
						e.Box.Size = Vector2.new(x2 - x1, y2 - y1)
						e.Box.Color = col

						local label = {}
						if Config.ESP.Name then table.insert(label, plr.DisplayName) end
						if Config.ESP.Health then table.insert(label, string.format("%d HP", math.floor(hum.Health))) end
						if Config.ESP.Distance then table.insert(label, string.format("[%d st]", math.floor(dist))) end
						e.Name.Visible = #label > 0
						e.Name.Text = table.concat(label, " ")
						e.Name.Position = Vector2.new((x1 + x2) / 2, y1 - 16)
						e.Name.Color = col

						local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
						e.HP.Visible = Config.ESP.Health
						e.HP.From = Vector2.new(x1 - 4, y2)
						e.HP.To = Vector2.new(x1 - 4, y2 - (y2 - y1) * frac)
						e.HP.Color = Color3.fromRGB(255 * (1 - frac), 255 * frac, 0)

						local head = parts.Head
						local hx1, hy1, hx2, hy2
						if head and Config.ESP.HeadBox then hx1, hy1, hx2, hy2 = projectBox(head.CFrame, head.Size) end
						if hx1 then
							e.Head.Visible = true
							e.Head.Position = Vector2.new(hx1, hy1 + yo)
							e.Head.Size = Vector2.new(hx2 - hx1, hy2 - hy1)
							e.Head.Color = e.rayVis.Head and Config.Colors.Visible or Config.Colors.Hidden
						else
							e.Head.Visible = false
						end
					else
						hideEntity(e)
					end

					-- aimbot candidates: chosen body part(s), inside FOV, nearest to crosshair
					if aimOn then
						local keys = (Config.Aim.Part == 7) and AIM_KEYS or { AIM_KEYS[Config.Aim.Part] }
						for _, k in ipairs(keys) do
							local part = parts[k]
							if part and (not Config.Aim.VisibleOnly or e.rayVis[k]) then
								local sp, on = Camera:WorldToViewportPoint(part.Position)
								if on and sp.Z > 0 then
									local s2 = Vector2.new(sp.X, sp.Y)
									local d = (s2 - center).Magnitude
									if d <= Config.Aim.FOV and d < bestDist then
										bestDist, bestPos, bestScreen = d, part.Position, s2
									end
								end
							end
						end
					end
				end
			end
		end
	end

	if bestPos and Config.Aim.Enabled then
		local holding = not Config.Aim.HoldRMB or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		if holding then
			local k = math.clamp(Config.Aim.Smooth, 0.02, 1)
			if centerIsScreen or not mousemoverel then
				Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(camPos, bestPos), k)
			else
				local d = (bestScreen - center) * k
				pcall(mousemoverel, d.X, d.Y)
			end
		end
	end
end

RunService:BindToRenderStep("FustRustMain", Enum.RenderPriority.Camera.Value + 1, onRender)
