	sf.Visible = false
	sf.Parent = window
	local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0, 5); l.Parent = sf
	return sf
end

local function showTab(name)
	for n, pg in pairs(pages) do pg.Visible = (n == name) end
	for n, b in pairs(tabButtons) do
		b.BackgroundColor3 = (n == name) and RUST or PANEL
		b.TextColor3 = (n == name) and Color3.new(1, 1, 1) or MUTED
	end
end

local function addTab(name, index, total)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1 / total, -6, 1, -4)
	b.Position = UDim2.new((index - 1) / total, 4, 0, 2)
	b.BackgroundColor3 = PANEL
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Font = FONT
	b.TextSize = 15
	b.Text = name
	b.Parent = tabBar
	stroke(b, EDGE, 1)
	b.Activated:Connect(function() showTab(name) end)
	tabButtons[name] = b
	pages[name] = makePage()
	return pages[name]
end

