----------------------------------------------------------------- unload
local function unload()
	if unloaded then return end
	unloaded = true
	pcall(function() RunService:UnbindFromRenderStep("FustRustMain") end)
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	for plr in pairs(entities) do removeEntity(plr) end
	if fovCircle then pcall(function() fovCircle:Remove() end) end
	gui:Destroy()
end
if getgenv then getgenv().__FUST_RUST_UNLOAD = unload end
