----------------------------------------------------------------- helpers
local function newDraw(kind, props)
	local o = Drawing.new(kind)
	for k, v in pairs(props) do o[k] = v end
	return o
end

local function findPart(char, names)
	for _, n in ipairs(names) do
		local p = char:FindFirstChild(n)
		if p and p:IsA("BasePart") then return p end
	end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function isPointVisible(origin, point)
	return Workspace:Raycast(origin, point - origin, rayParams) == nil
end

local function accumulate(cf, size, b)
	local h = size / 2
	for sx = -1, 1, 2 do
		for sy = -1, 1, 2 do
			for sz = -1, 1, 2 do
				local p = Camera:WorldToViewportPoint((cf * CFrame.new(h.X * sx, h.Y * sy, h.Z * sz)).Position)
				if p.Z <= 0 then return false end
				if p.X < b[1] then b[1] = p.X end
				if p.Y < b[2] then b[2] = p.Y end
				if p.X > b[3] then b[3] = p.X end
				if p.Y > b[4] then b[4] = p.Y end
			end
		end
	end
	return true
end

local function projectBox(cf, size)
	local b = { math.huge, math.huge, -math.huge, -math.huge }
	if not accumulate(cf, size, b) or b[1] ~= b[1] or b[3] ~= b[3] then return nil end
	return b[1], b[2], b[3], b[4]
end

-- Only the character's direct body parts, so hair/hats don't stretch the box.
local function bodyBox(char)
	local b = { math.huge, math.huge, -math.huge, -math.huge }
	local n = 0
	for _, p in ipairs(char:GetChildren()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			if not accumulate(p.CFrame, p.Size, b) then return nil end
			n += 1
		end
	end
	if n == 0 or b[1] ~= b[1] or b[3] ~= b[3] then return nil end
	return b[1], b[2], b[3], b[4]
end

local function isTeammate(plr)
	return LP.Team ~= nil and plr.Team == LP.Team
end

-- The game's crosshair: screen center when the mouse is locked / on mobile, else the cursor.
local function getAimCenter()
	local atCenter = Config.Aim.ForceCenter
		or UIS.MouseBehavior == Enum.MouseBehavior.LockCenter
		or not UIS.MouseEnabled
	if atCenter then return Camera.ViewportSize / 2, true end
	return UIS:GetMouseLocation(), false
end

----------------------------------------------------------------- drawing objects
local fovCircle
